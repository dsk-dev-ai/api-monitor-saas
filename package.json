{
  "name": "api-monitor-saas",
  "version": "2.0.0",
  "description": "Open-source API & website uptime monitoring SaaS — periodic health checks, uptime analytics, email alerts, and public status pages. Next.js + Express + Prisma + monitoring worker.",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:worker\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:worker": "npm run dev -w worker",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:worker": "npm run build -w worker",
    "start": "npm run start -w backend",
    "db:push": "npm run db:push -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:studio": "npm run db:studio -w backend",
    "db:generate": "npm run db:generate -w backend",
    "test": "npm run test -w backend",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
