# ─────────────────────────────────────────────────────────────────────────────
# API Monitor SaaS — environment configuration
#
#   cp .env.example .env
#
# Only SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are required
# to run locally. Everything else has a working default or is feature-gated off.
#
# This file is committed. Never put real credentials in it. The Docker build
# context excludes .env (see .dockerignore), so your real values are not baked
# into images.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Used by tooling you run directly on the host (npm scripts, Prisma CLI).
# For the Docker Compose stack, DATABASE_URL_DOCKER below is used instead,
# because "localhost" is not reachable from inside the compose network.
DATABASE_URL="postgresql://api_monitor:dev_password@localhost:5434/api_monitor"

# Address the backend and worker containers use to reach PostgreSQL. Leave this
# unset to use the bundled compose database. Set it to target an external
# database instead.
# DATABASE_URL_DOCKER="postgresql://user:password@host:5432/database"

# ── Supabase (required — supplies authentication) ────────────────────────────
# API Monitor delegates auth to Supabase. A fully offline install is not possible
# in this edition; see ROADMAP.md (P2) and docs/AUTH_DESIGN.md.
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"

# Grants full administrative access to the Supabase auth schema. Required by the
# backend to verify tokens. Never expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Minimum 64 characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-min-64-characters-0123456789abcdef0123456789abcdef0123456789ab"

# ── Feature flags ────────────────────────────────────────────────────────────
# Emails and billing are off by default and additionally require their API keys
# (see backend/src/config/env.ts). Setting a flag without its keys logs a warning
# and leaves the feature disabled.
ENABLE_SIGNUPS=true
ENABLE_EMAILS=false
ENABLE_BILLING=false

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"

# ── Stripe (optional — required only when ENABLE_BILLING=true) ───────────────
# Backend only. The dashboard billing page does not yet complete a purchase.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."

# ── Email via Resend (optional — required only when ENABLE_EMAILS=true) ──────
# Also used as the Supabase SMTP sender for verification and reset emails.
RESEND_API_KEY="re_..."
FROM_EMAIL="alerts@example.com"

# ── Redis ────────────────────────────────────────────────────────────────────
# Optional. The compose stack runs Redis, but no code path reads it yet — the
# BullMQ queue integration is tracked in ROADMAP.md (P1).
REDIS_URL="redis://redis:6379"

# ── Worker ───────────────────────────────────────────────────────────────────
# Minimum enforced value is 30 seconds regardless of what is set here.
CHECK_INTERVAL_SECONDS=30

# Days of check history to retain. The daily sweep deletes older rows.
CLEANUP_DAYS=90
