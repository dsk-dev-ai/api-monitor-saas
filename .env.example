# Database (Supabase PostgreSQL — free hosted project)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase (free hosted project)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Backend
PORT=3001
NODE_ENV=production
JWT_SECRET="change-me-min-64-characters-0123456789abcdef0123456789abcdef0123456789ab"
FRONTEND_URL="https://[your-frontend-domain]"

# Feature flags (backend /auth + billing gating)
ENABLE_EMAILS=true
ENABLE_BILLING=true
ENABLE_SIGNUPS=true
ENABLE_WORKSPACES=true
ENABLE_TEAMS=true

# Frontend
NEXT_PUBLIC_API_URL="https://[backend-domain]/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"

# Stripe (test mode first, then live). Price IDs created in Stripe Dashboard.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_BASIC="price_..."
STRIPE_PRICE_PRO="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Email (Resend free tier — also used as Supabase SMTP sender for verification emails)
RESEND_API_KEY="re_..."
FROM_EMAIL="alerts@yourdomain.com"

# Redis (upstream free-tier instance, e.g. Upstash)
REDIS_URL="redis://default:[password]@[region].upstash.io:xxxxx"

# Worker
CHECK_INTERVAL_SECONDS=30
CLEANUP_DAYS=90